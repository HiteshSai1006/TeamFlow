datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model HealthCheck {
  id        Int      @id @default(autoincrement())
  checkedAt DateTime @default(now())
  status    String
}

enum SystemRole {
  ADMIN
  MEMBER
}

model User {
  id                 Int             @id @default(autoincrement())
  name               String
  email              String          @unique
  passwordHash       String
  systemRole         SystemRole      @default(MEMBER)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  createdProjects    Project[]       @relation("CreatedProjects")
  projectMemberships ProjectMember[]
  createdTasks       Task[]          @relation("CreatedTasks")
  assignedTasks      Task[]          @relation("AssignedTasks")
  activityLogs       ActivityLog[]
  comments           Comment[]
  uploadedAttachments Attachment[]
  createdRCAs        RCA[]           @relation("CreatedRCAs")
  reviews            Review[]
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model Project {
  id          Int             @id @default(autoincrement())
  name        String
  description String?
  status      ProjectStatus   @default(ACTIVE)
  createdById Int
  createdBy   User            @relation("CreatedProjects", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     ProjectMember[]
  tasks       Task[]
  activityLogs ActivityLog[]
  rcas        RCA[]
}

enum ProjectRole {
  MANAGER
  MEMBER
  REVIEWER
}

model ProjectMember {
  id        Int         @id @default(autoincrement())
  projectId Int
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole
  joinedAt  DateTime    @default(now())

  @@unique([projectId, userId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Task {
  id                Int            @id @default(autoincrement())
  projectId         Int
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  status            TaskStatus     @default(TODO)
  priority          TaskPriority   @default(MEDIUM)
  assigneeId        Int?
  assignee          User?          @relation("AssignedTasks", fields: [assigneeId], references: [id])
  dueDate           DateTime?
  createdById       Int
  createdBy         User           @relation("CreatedTasks", fields: [createdById], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  activityLogs      ActivityLog[]
  outgoingRelations TaskRelation[] @relation("SourceRelations")
  incomingRelations TaskRelation[] @relation("TargetRelations")
  comments          Comment[]
  attachments       Attachment[]
}

enum ActivityEventType {
  TASK_CREATE
  TASK_UPDATE
  TASK_ASSIGN
  TASK_STATUS_CHANGE
  TASK_DUE_DATE_CHANGE
  TASK_DEPENDENCY_ADDED
  TASK_DEPENDENCY_REMOVED
}

model ActivityLog {
  id          Int               @id @default(autoincrement())
  projectId   Int
  project     Project           @relation(fields: [projectId], references: [id])
  taskId      Int
  task        Task              @relation(fields: [taskId], references: [id])
  actorId     Int
  actor       User              @relation(fields: [actorId], references: [id])
  eventType   ActivityEventType
  metadata    Json
  createdAt   DateTime          @default(now())
}

enum RelationType {
  BLOCKS
}

model TaskRelation {
  id           Int          @id @default(autoincrement())
  sourceTaskId Int
  sourceTask   Task         @relation("SourceRelations", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  targetTaskId Int
  targetTask   Task         @relation("TargetRelations", fields: [targetTaskId], references: [id], onDelete: Cascade)
  type         RelationType @default(BLOCKS)

  @@unique([sourceTaskId, targetTaskId])
}

model Comment {
  id        Int       @id @default(autoincrement())
  taskId    Int
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  authorId  Int
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content   String
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Attachment {
  id           Int      @id @default(autoincrement())
  taskId       Int
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedById Int
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  originalName String
  storageKey   String   @unique
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
}

enum RCASeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RCAStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
  CLOSED
}

enum RCASectionType {
  TIMELINE
  CONTRIBUTING_FACTORS
  CORRECTIVE_ACTIONS
  PREVENTIVE_MEASURES
}

enum ReviewDecision {
  PENDING
  APPROVED
  REJECTED
}

model RCA {
  id           Int          @id @default(autoincrement())
  projectId    Int
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  title        String
  description  String?
  severity     RCASeverity
  status       RCAStatus    @default(DRAFT)
  reviewRound  Int          @default(1)
  createdById  Int
  createdBy    User         @relation("CreatedRCAs", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sections     RCASection[]
  reviews      Review[]
}

model RCASection {
  id        Int            @id @default(autoincrement())
  rcaId     Int
  rca       RCA            @relation(fields: [rcaId], references: [id], onDelete: Restrict)
  type      RCASectionType
  content   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([rcaId, type])
}

model Review {
  id         Int            @id @default(autoincrement())
  rcaId      Int
  rca        RCA            @relation(fields: [rcaId], references: [id], onDelete: Restrict)
  reviewerId Int
  reviewer   User           @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  round      Int
  decision   ReviewDecision @default(PENDING)
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime       @default(now())

  @@unique([rcaId, reviewerId, round])
}
