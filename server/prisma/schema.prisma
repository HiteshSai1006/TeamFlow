datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model HealthCheck {
  id        Int      @id @default(autoincrement())
  checkedAt DateTime @default(now())
  status    String
}

enum SystemRole {
  ADMIN
  MEMBER
}

model User {
  id                 Int             @id @default(autoincrement())
  name               String
  email              String          @unique
  passwordHash       String
  systemRole         SystemRole      @default(MEMBER)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  createdProjects    Project[]       @relation("CreatedProjects")
  projectMemberships ProjectMember[]
  createdTasks       Task[]          @relation("CreatedTasks")
  assignedTasks      Task[]          @relation("AssignedTasks")
  activityLogs       ActivityLog[]
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model Project {
  id          Int             @id @default(autoincrement())
  name        String
  description String?
  status      ProjectStatus   @default(ACTIVE)
  createdById Int
  createdBy   User            @relation("CreatedProjects", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     ProjectMember[]
  tasks       Task[]
  activityLogs ActivityLog[]
}

enum ProjectRole {
  MANAGER
  MEMBER
  REVIEWER
}

model ProjectMember {
  id        Int         @id @default(autoincrement())
  projectId Int
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole
  joinedAt  DateTime    @default(now())

  @@unique([projectId, userId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Task {
  id                Int            @id @default(autoincrement())
  projectId         Int
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  status            TaskStatus     @default(TODO)
  priority          TaskPriority   @default(MEDIUM)
  assigneeId        Int?
  assignee          User?          @relation("AssignedTasks", fields: [assigneeId], references: [id])
  dueDate           DateTime?
  createdById       Int
  createdBy         User           @relation("CreatedTasks", fields: [createdById], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  activityLogs      ActivityLog[]
  outgoingRelations TaskRelation[] @relation("SourceRelations")
  incomingRelations TaskRelation[] @relation("TargetRelations")
}

enum ActivityEventType {
  TASK_CREATE
  TASK_UPDATE
  TASK_ASSIGN
  TASK_STATUS_CHANGE
  TASK_DUE_DATE_CHANGE
  TASK_DEPENDENCY_ADDED
  TASK_DEPENDENCY_REMOVED
}

model ActivityLog {
  id          Int               @id @default(autoincrement())
  projectId   Int
  project     Project           @relation(fields: [projectId], references: [id])
  taskId      Int
  task        Task              @relation(fields: [taskId], references: [id])
  actorId     Int
  actor       User              @relation(fields: [actorId], references: [id])
  eventType   ActivityEventType
  metadata    Json
  createdAt   DateTime          @default(now())
}

enum RelationType {
  BLOCKS
}

model TaskRelation {
  id           Int          @id @default(autoincrement())
  sourceTaskId Int
  sourceTask   Task         @relation("SourceRelations", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  targetTaskId Int
  targetTask   Task         @relation("TargetRelations", fields: [targetTaskId], references: [id], onDelete: Cascade)
  type         RelationType @default(BLOCKS)

  @@unique([sourceTaskId, targetTaskId])
}
